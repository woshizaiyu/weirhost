# 本地调试用，复制为 .env 后填入
# 格式: 备注-----remember_web_xxx=yyy  或 纯 remember_web_xxx=yyy
WEIRDHOST_COOKIE_1=备注-----remember_web_59ba36addc2b2f940000000=xxx
# WEIRDHOST_COOKIE_2=
# WEIRDHOST_COOKIE_3=
# WEIRDHOST_COOKIE_4=
# WEIRDHOST_COOKIE_5=

# 可选：兼容旧版 JSON 数组（优先级低于 COOKIE_1..5）
# WEIRDHOST_ACCOUNTS=[{"remark":"我的号","cookie":"remember_web_xxx=yyy"}]

# 可选：Telegram 通知
TG_BOT_TOKEN=
TG_CHAT_ID=

# 可选：自动回写 GitHub Secrets
REPO_TOKEN=
GITHUB_REPOSITORY=owner/repo

# 可选：家宽代理（直连失败时再配，格式 http://user:pass@ip:port 或 http://ip:port）
WEIRDHOST_PROXY=http://ip:port
# HTTPS_PROXY=http://ip:port
# HTTP_PROXY=http://ip:port

# 可选：续期阈值（天），默认 2
RENEW_THRESHOLD_DAYS=2
